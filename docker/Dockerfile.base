FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    git \
    jq \
    nodejs \
    npm \
    ripgrep \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN mkdir -p /tmp/agent_scratch && chmod 1777 /tmp/agent_scratch

ENV HOME=/tmp/agent_scratch
CMD ["sleep", "infinity"]
